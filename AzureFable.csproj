<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\GameIcon.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);outputs\**;.temp\**;.dotnet-home\**;.localappdata\**;**\node_modules\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\BrokenHeart.png" />
    <None Remove="Assets\Enemy.png" />
    <None Remove="Assets\Floor.png" />
    <None Remove="Assets\GameIcon.ico" />
    <None Remove="Assets\GameIcon.png" />
    <None Remove="Assets\GameLogo.png" />
    <None Remove="Assets\Ghost.png" />
    <None Remove="Assets\Heart.png" />
    <None Remove="Assets\Hero.png" />
    <None Remove="Assets\Key.png" />
    <None Remove="Assets\Menu.jpg" />
    <None Remove="Assets\Portal.png" />
    <None Remove="Assets\Wall.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BrokenHeart.png" />
    <Resource Include="Assets\Enemy.png" />
    <Resource Include="Assets\Floor.png" />
    <Resource Include="Assets\GameIcon.ico" />
    <Resource Include="Assets\GameIcon.png" />
    <Resource Include="Assets\GameLogo.png" />
    <Resource Include="Assets\Ghost.png" />
    <Resource Include="Assets\Heart.png" />
    <Resource Include="Assets\Hero.png" />
    <Resource Include="Assets\Key.png" />
    <Resource Include="Assets\Menu.jpg" />
    <Resource Include="Assets\Portal.png" />
    <Resource Include="Assets\Wall.png" />
  </ItemGroup>

</Project>
