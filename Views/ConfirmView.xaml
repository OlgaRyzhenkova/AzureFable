<UserControl x:Class="AzureFable.Views.ConfirmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="138"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Constantia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#E6051121"
                                BorderBrush="#7700D2FF"
                                BorderThickness="1.2"
                                CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D2FF"
                                                  BlurRadius="3"
                                                  ShadowDepth="0"
                                                  Opacity="0.18"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E60A2A45"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00FFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Border Width="440"
                Height="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F0051121"
                BorderBrush="#AA00D2FF"
                BorderThickness="1.5"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.32"/>
            </Border.Effect>

            <StackPanel Margin="26,20"
                        VerticalAlignment="Center">
                <TextBlock Text="ПІДТВЕРДЖЕННЯ"
                           Foreground="White"
                           FontFamily="Constantia"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,10"/>

                <Rectangle Height="1"
                           Fill="#6600D2FF"
                           Margin="0,0,0,22"/>

                <TextBlock x:Name="QuestionText"
                           Foreground="#E0F7FF"
                           FontFamily="Constantia"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource DialogButtonStyle}"
                            Margin="0,0,18,0"
                            Click="YesButton_Click">
                        <TextBlock Text="Так"
                                   Foreground="#FF7788"
                                   FontFamily="Constantia"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                    </Button>

                    <Button Style="{StaticResource DialogButtonStyle}"
                            IsCancel="True"
                            Click="NoButton_Click">
                        <TextBlock Text="Ні"
                                   Foreground="#88CCFF"
                                   FontFamily="Constantia"
                                   FontSize="17"
                                   FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
