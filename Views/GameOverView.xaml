<UserControl x:Class="AzureFable.Views.GameOverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="420">

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource ScreenTitleStyle}"
                       FontSize="52"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>

            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource ScreenSubtitleStyle}"
                       TextAlignment="Center"
                       Margin="0,0,0,54"/>

            <Button Content="Грати знову"
                    x:Name="PlayAgainButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,0,18"
                    Click="PlayAgainButton_Click"/>

            <Button Content="Головне меню"
                    x:Name="MenuButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="MenuButton_Click"/>

        </StackPanel>

    </Grid>
</UserControl>
