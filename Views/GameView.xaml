<UserControl x:Class="AzureFable.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="GameSceneBackgroundBrush"
                             StartPoint="0,0"
                             EndPoint="0,1">
            <GradientStop Color="#07091D" Offset="0"/>
            <GradientStop Color="#0A0D27" Offset="0.48"/>
            <GradientStop Color="#050815" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HealthPanelBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#E60D1324" Offset="0"/>
            <GradientStop Color="#D7191022" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KeyPanelBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#E60D1324" Offset="0"/>
            <GradientStop Color="#D7241D0E" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="GameHudPanelStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,9"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource GameSceneBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource GameHudPanelStyle}"
                    Background="{StaticResource HealthPanelBrush}"
                    BorderBrush="#AAE84A5F"
                    HorizontalAlignment="Left"
                    MinWidth="262">
                <Border.Effect>
                    <DropShadowEffect Color="#E84A5F"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Здоров'я"
                               Style="{StaticResource HudTextStyle}"
                               Foreground="#F6FAFF"
                               FontFamily="Constantia"
                               FontSize="21"
                               Margin="0,0,14,0"/>

                    <ItemsControl ItemsSource="{Binding Hearts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding}"
                                       Width="28"
                                       Height="28"
                                       Margin="3,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource GameHudPanelStyle}"
                    Background="{StaticResource KeyPanelBrush}"
                    BorderBrush="#AADCBA4A"
                    MinWidth="86"
                    Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect Color="#F5C842"
                                      BlurRadius="12"
                                      ShadowDepth="0"
                                      Opacity="0.2"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="/Assets/Key.png"
                           Width="28"
                           Height="28"
                           Margin="0,0,10,0"/>

                    <TextBlock Text="Ключ знайдено"
                               Style="{StaticResource HudTextStyle}"
                               Foreground="#F5D76E"
                               FontFamily="Constantia"
                               FontSize="16"
                               Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Content="ДОВІДКА"
                    Command="{Binding HelpCommand}"
                    Style="{StaticResource CrystalHudButtonStyle}"
                    Width="120"
                    Height="46"
                    Margin="0,0,14,0"/>

            <Button Grid.Column="3"
                    Content="⏸ ПАУЗА"
                    Command="{Binding PauseCommand}"
                    Style="{StaticResource CrystalHudButtonStyle}"
                    Width="120"
                    Height="46"/>
        </Grid>

        <Viewbox Grid.Row="1"
                 Margin="28,0,28,18"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Border Width="928"
                    Height="528"
                    Background="#F0051121"
                    BorderBrush="#7A00D2FF"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="2">
                <Border.Effect>
                    <DropShadowEffect Color="#00D2FF"
                                      BlurRadius="14"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Border.Effect>

                <Grid Width="920"
                      Height="520"
                      ClipToBounds="True">

                <ItemsControl ItemsSource="{Binding Cells}"
                              Width="920"
                              Height="520">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource CellSizeConverter}}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource CellSizeConverter}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#15193F"
                                    BorderThickness="0.5"
                                    Width="40"
                                    Height="40">
                                <Image Source="{Binding ImagePath}"
                                       ToolTip="{Binding Name}"
                                       Stretch="Fill"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding GameObjects}"
                              Width="920"
                              Height="520">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource CellSizeConverter}}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource CellSizeConverter}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}"
                                   ToolTip="{Binding Name}"
                                   Width="40"
                                   Height="40"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
