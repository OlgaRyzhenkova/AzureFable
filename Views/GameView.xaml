<UserControl x:Class="AzureFable.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyDown="UserControl_KeyDown"
             Focusable="True">

    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource HudPanelStyle}"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Здоров'я"
                               Style="{StaticResource HudTextStyle}"
                               Margin="0,0,12,0"/>

                    <ItemsControl ItemsSource="{Binding Hearts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="/Assets/Heart.png"
                                       Width="28"
                                       Height="28"
                                       Margin="2,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource HudPanelStyle}"
                    Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Key.png"
                           Width="28"
                           Height="28"
                           Margin="0,0,8,0"/>

                    <TextBlock Text="Ключ знайдено"
                               Style="{StaticResource HudTextStyle}"
                               Foreground="{StaticResource AccentGoldBrush}"
                               Visibility="{Binding HasKey, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Content="Пауза"
                    Command="{Binding PauseCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="120"
                    Height="46"/>
        </Grid>

        <Border Grid.Row="1"
                Width="928"
                Height="528"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="6"
                Padding="2">

            <Grid Width="920"
                  Height="520"
                  ClipToBounds="True">

                <ItemsControl ItemsSource="{Binding Cells}"
                              Width="920"
                              Height="520">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource CellSizeConverter}}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource CellSizeConverter}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#15193F"
                                    BorderThickness="0.5"
                                    Width="40"
                                    Height="40">
                                <Image Source="{Binding ImagePath}"
                                       Stretch="Fill"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding GameObjects}"
                              Width="920"
                              Height="520">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource CellSizeConverter}}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource CellSizeConverter}}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding ImagePath}"
                                   Width="40"
                                   Height="40"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>


    </Grid>
</UserControl>
