<UserControl x:Class="AzureFable.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#99000000"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Border Width="560"
                Height="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F0051121"
                BorderBrush="#AA00D2FF"
                BorderThickness="1.5"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF"
                                  BlurRadius="18"
                                  ShadowDepth="0"
                                  Opacity="0.42"/>
            </Border.Effect>

            <StackPanel Margin="34,28">
                <TextBlock Text="— ДОВІДКА —"
                           Foreground="#E0F7FF"
                           FontFamily="Constantia"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CCFF"
                                          BlurRadius="5"
                                          ShadowDepth="0"
                                          Opacity="0.55"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Rectangle Height="1"
                           Fill="#5500D2FF"
                           Margin="0,0,0,22"/>

                <StackPanel Margin="18,0,18,28">
                    <TextBlock Text="↑ ↓ ← →   керують героєм"
                               Style="{StaticResource HelpLineStyle}"/>
                    <TextBlock Text="Esc або кнопка ПАУЗА   призупиняє гру"
                               Style="{StaticResource HelpLineStyle}"/>
                    <TextBlock Text="Ключ відкриває портал"
                               Style="{StaticResource HelpLineStyle}"/>
                    <TextBlock Text="Портал завершує гру перемогою"
                               Style="{StaticResource HelpLineStyle}"/>
                    <TextBlock Text="Серце відновлює здоров'я"
                               Style="{StaticResource HelpLineStyle}"/>
                    <TextBlock Text="Вороги забирають здоров'я героя"
                               Style="{StaticResource HelpLineStyle}"/>
                </StackPanel>

                <Button Content="Назад"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
