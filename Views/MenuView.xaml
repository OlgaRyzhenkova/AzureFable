<UserControl x:Class="AzureFable.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="CrystalMenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E0F7FF"/>
            <Setter Property="FontFamily" Value="Constantia"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot">
                            <Border x:Name="ButtonBorder"
                                    Background="#E6051121"
                                    BorderBrush="#7700D2FF"
                                    BorderThickness="1.2"
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00D2FF"
                                                      BlurRadius="6"
                                                      ShadowDepth="0"
                                                      Opacity="0.25"/>
                                </Border.Effect>
                            </Border>
                            <Border BorderThickness="1,1,0,0"
                                    BorderBrush="White"
                                    Opacity="0.08"
                                    Margin="1"
                                    CornerRadius="3"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="#00D2FF"
                                           FontSize="20"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E60A2A45"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00FFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97"
                                                        ScaleY="0.97"
                                                        CenterX="150"
                                                        CenterY="27"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Image Source="/Assets/Menu.jpg"
               Stretch="UniformToFill"/>

        <Rectangle Opacity="0.46">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5"
                                     RadiusX="0.65"
                                     RadiusY="0.72">
                    <GradientStop Color="#AA000000" Offset="0"/>
                    <GradientStop Color="#22000000" Offset="0.58"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Viewbox Stretch="Uniform">
            <StackPanel Width="1024"
                        Height="600"
                        VerticalAlignment="Center">

                <TextBlock Text="AZURE FABLE"
                           Foreground="#F0FBFF"
                           FontSize="86"
                           FontFamily="Constantia"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,58,0,42">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00CCFF"
                                          BlurRadius="8"
                                          ShadowDepth="0"
                                          Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>

                <Button Tag="✧"
                        Command="{Binding StartGameCommand}"
                        Style="{StaticResource CrystalMenuButtonStyle}"
                        IsDefault="True">
                    <TextBlock Text="РОЗПОЧАТИ ГРУ"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

                <Button Tag="✦"
                        Command="{Binding SettingsCommand}"
                        Style="{StaticResource CrystalMenuButtonStyle}">
                    <TextBlock Text="НАЛАШТУВАННЯ"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

                <Button Tag="✺"
                        Command="{Binding HelpCommand}"
                        Style="{StaticResource CrystalMenuButtonStyle}">
                    <TextBlock Text="ДОВІДКА"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

                <Button Tag="×"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource CrystalMenuButtonStyle}"
                        IsCancel="True">
                    <TextBlock Text="ВИЙТИ"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>
