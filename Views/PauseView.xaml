<UserControl x:Class="AzureFable.Views.PauseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="420">

            <TextBlock Text="Пауза"
                       Style="{StaticResource ScreenTitleStyle}"
                       FontSize="52"
                       Margin="0,0,0,14"/>

            <TextBlock Text="Гра призупинена"
                       Style="{StaticResource ScreenSubtitleStyle}"
                       TextAlignment="Center"
                       Margin="0,0,0,54"/>

            <Button Content="Продовжити"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,0,18"
                    Click="ResumeButton_Click"/>

            <Button Content="Почати заново"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,0,18"
                    Click="RestartButton_Click"/>

            <Button Content="Головне меню"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="MenuButton_Click"/>

        </StackPanel>
    </Grid>
</UserControl>
