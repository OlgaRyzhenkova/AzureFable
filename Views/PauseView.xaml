<UserControl x:Class="AzureFable.Views.PauseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="PauseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E0F7FF"/>
            <Setter Property="FontFamily" Value="Constantia"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="#E6051121"
                                BorderBrush="#7700D2FF"
                                BorderThickness="1.2"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Foreground="#00D2FF"
                                           FontSize="20"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E60A2A45"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00FFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Border Width="380"
                Height="334"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F0051121"
                BorderBrush="#AA00D2FF"
                BorderThickness="1.5"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF"
                                  BlurRadius="6"
                                  ShadowDepth="0"
                                  Opacity="0.22"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24,28">

                <TextBlock Text="— ПАУЗА —"
                           Foreground="White"
                           FontFamily="Constantia"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <Rectangle Height="1"
                           Width="300"
                           Fill="#5500D2FF"
                           Margin="0,4,0,20"/>

                <Button Tag="▶"
                        Style="{StaticResource PauseButtonStyle}"
                        Width="300"
                        Height="56"
                        Margin="0,0,0,8"
                        IsDefault="True"
                        Click="ResumeButton_Click">
                    <TextBlock Text="Продовжити"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="20"
                               FontWeight="Bold"/>
                </Button>

                <Button Tag="↺"
                        Style="{StaticResource PauseButtonStyle}"
                        Width="300"
                        Height="48"
                        Margin="0,0,0,8"
                        Click="RestartButton_Click">
                    <TextBlock Text="Рестарт"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

                <Button Tag="⌂"
                        Style="{StaticResource PauseButtonStyle}"
                        Width="300"
                        Height="48"
                        Click="MenuButton_Click">
                    <TextBlock Text="Головне меню"
                               Foreground="White"
                               FontFamily="Constantia"
                               FontSize="18"
                               FontWeight="Bold"/>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
