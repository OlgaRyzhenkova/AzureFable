<UserControl x:Class="AzureFable.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BackgroundBrush}"
          TextOptions.TextFormattingMode="Display"
          TextOptions.TextRenderingMode="ClearType">
        <Border Width="560"
                Height="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F0051121"
                BorderBrush="#AA00D2FF"
                BorderThickness="1.5"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF"
                                  BlurRadius="10"
                                  ShadowDepth="0"
                                  Opacity="0.32"/>
            </Border.Effect>

            <StackPanel Margin="34,28">
                <TextBlock Text="НАЛАШТУВАННЯ"
                           Foreground="White"
                           FontFamily="Constantia"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <Rectangle Height="1"
                           Fill="#6600D2FF"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Складність гри"
                           Foreground="#E0F7FF"
                           FontFamily="Constantia"
                           FontSize="21"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="{Binding DifficultyText, StringFormat=Поточний режим: {0}}"
                           Foreground="#88CCFF"
                           FontFamily="Constantia"
                           FontSize="17"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,32">
                    <Button Content="Легка"
                            Command="{Binding EasyCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="145"
                            Margin="0,0,12,0"/>

                    <Button Content="Звичайна"
                            Command="{Binding NormalCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="145"
                            Margin="0,0,12,0"/>

                    <Button Content="Важка"
                            Command="{Binding HardCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="145"/>
                </StackPanel>

                <Button Content="Назад"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
